# Copy to .env for local development. Never commit real secrets.
PORT=4000
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# PostgreSQL. Without it the API keeps data in memory (development only).
# Start one with: docker compose -f infra/docker-compose.yml up -d
DATABASE_URL=postgres://oenodpay:localdev-only@localhost:5432/oenodpay
# Passkeys are tied to this domain (use the real domain in production, e.g. oenodpay.com)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000,http://localhost:8081
# Identity verification vendor ('sandbox' is refused in production)
KYC_PROVIDER=sandbox
# Shared secret for signed vendor webhooks. Generate with: openssl rand -hex 32
# KYC_WEBHOOK_SECRET=
