{
  "expo": {
    "name": "oenodPay",
    "slug": "oenodpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/placeholder/icon-1024.png",
    "scheme": "oenodpay",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.oenodpay.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "OenodPay uses Face ID to confirm payments and protect your account."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.oenodpay.app",
      "allowBackup": false,
      "icon": "./assets/placeholder/icon-512.png"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/placeholder/favicon-32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1020",
          "image": "./assets/placeholder/icon-rounded-512.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}