{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:record": "tsx scripts/i18n.ts demo && rm -f .i18n-record.jsonl && I18N_RECORD=$PWD/.i18n-record.jsonl next build && tsx scripts/i18n.ts source .i18n-record.jsonl",
    "i18n:check": "tsx scripts/i18n.ts check"
  },
  "dependencies": {
    "@oenodpay/shared": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.28.0"
}
